{
  "name": "edupulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "community project",
    "frontend community/project"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace=edupulse-server\" \"npm run dev --workspace=edupulse-frontend\"",
    "dev:api": "npm run dev --workspace=edupulse-server",
    "dev:frontend": "npm run dev --workspace=edupulse-frontend",
    "build": "npm run build --workspace=edupulse-frontend",
    "test:api": "npm test --workspace=edupulse-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
